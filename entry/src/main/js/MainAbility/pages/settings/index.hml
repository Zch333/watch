<list class="container">
    <list-item class="item">
        <div class="column">
            <text class="title">设置</text>
            <text class="label">工作日（点按切换）</text>
            <div class="row">
                <text class="chip" style="background-color: {{weekdayBg0}}; color: {{weekdayFg0}}" onclick="onWeekdayTap(0)">一</text>
                <text class="chip" style="background-color: {{weekdayBg1}}; color: {{weekdayFg1}}" onclick="onWeekdayTap(1)">二</text>
                <text class="chip" style="background-color: {{weekdayBg2}}; color: {{weekdayFg2}}" onclick="onWeekdayTap(2)">三</text>
                <text class="chip" style="background-color: {{weekdayBg3}}; color: {{weekdayFg3}}" onclick="onWeekdayTap(3)">四</text>
                <text class="chip" style="background-color: {{weekdayBg4}}; color: {{weekdayFg4}}" onclick="onWeekdayTap(4)">五</text>
                <text class="chip" style="background-color: {{weekdayBg5}}; color: {{weekdayFg5}}" onclick="onWeekdayTap(5)">六</text>
                <text class="chip" style="background-color: {{weekdayBg6}}; color: {{weekdayFg6}}" onclick="onWeekdayTap(6)">日</text>
            </div>
            <text class="label">工作时段</text>
            <text class="chip" style="width: 300px; text-align: center; background-color: {{blockBg0}}; color: {{blockFg0}}" onclick="onBlockTap(0)">09:00–12:00 / 13:30–18:00</text>
            <text class="chip" style="width: 300px; text-align: center; background-color: {{blockBg1}}; color: {{blockFg1}}" onclick="onBlockTap(1)">08:30–12:00 / 13:00–17:30</text>
            <text class="chip" style="width: 300px; text-align: center; background-color: {{blockBg2}}; color: {{blockFg2}}" onclick="onBlockTap(2)">09:00–11:30 / 14:00–17:30</text>
            <text class="label">节律（工作 / 活动）</text>
            <div class="row">
                <text class="chip" style="background-color: {{rhythmBg0}}; color: {{rhythmFg0}}" onclick="onRhythmTap(0)">25/5</text>
                <text class="chip" style="background-color: {{rhythmBg1}}; color: {{rhythmFg1}}" onclick="onRhythmTap(1)">50/10</text>
                <text class="chip" style="background-color: {{rhythmBg2}}; color: {{rhythmFg2}}" onclick="onRhythmTap(2)">45/15</text>
                <text class="chip" style="background-color: {{rhythmBg3}}; color: {{rhythmFg3}}" onclick="onRhythmTap(3)">30/5</text>
            </div>
            <text class="error" show="{{hasError}}">{{errorText}}</text>
            <input type="button" class="btn-primary" value="保存" onclick="onSave"></input>
        </div>
    </list-item>
</list>
