<div class="container">
    <text class="title">设置</text>
    <text class="label">工作日（点按切换）</text>
    <div class="row">
        <text class="chip {{weekdayClass0}}" onclick="onWeekdayTap(0)">一</text>
        <text class="chip {{weekdayClass1}}" onclick="onWeekdayTap(1)">二</text>
        <text class="chip {{weekdayClass2}}" onclick="onWeekdayTap(2)">三</text>
        <text class="chip {{weekdayClass3}}" onclick="onWeekdayTap(3)">四</text>
        <text class="chip {{weekdayClass4}}" onclick="onWeekdayTap(4)">五</text>
    </div>
    <text class="label">工作时段</text>
    <text class="chip wide {{blockClass0}}" onclick="onBlockTap(0)">09:00–12:00 / 13:30–18:00</text>
    <text class="chip wide {{blockClass1}}" onclick="onBlockTap(1)">08:30–12:00 / 13:00–17:30</text>
    <text class="chip wide {{blockClass2}}" onclick="onBlockTap(2)">09:00–11:30 / 14:00–17:30</text>
    <text class="label">节律（工作 / 活动）</text>
    <div class="row">
        <text class="chip {{rhythmClass0}}" onclick="onRhythmTap(0)">25/5</text>
        <text class="chip {{rhythmClass1}}" onclick="onRhythmTap(1)">50/10</text>
        <text class="chip {{rhythmClass2}}" onclick="onRhythmTap(2)">45/15</text>
        <text class="chip {{rhythmClass3}}" onclick="onRhythmTap(3)">30/5</text>
    </div>
    <button class="btn primary" onclick="onSave">保存</button>
</div>
