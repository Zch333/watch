<div class="container">
    <text class="banner" style="color: {{bannerColor}}">{{capabilityText}}</text>
    <text class="status">计划：{{planStatusText}}</text>
    <text class="next">下次活动 {{nextBreak}}</text>
    <text class="error" if="{{hasError}}">{{errorText}}</text>
    <input type="button" class="btn-primary" value="立即活动" onclick="onStartNow"></input>
    <input type="button" class="btn" value="启用 / 关闭" onclick="onToggle"></input>
    <input type="button" class="btn" value="更多" onclick="onMore"></input>
</div>
