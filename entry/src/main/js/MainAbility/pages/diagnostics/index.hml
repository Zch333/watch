<div class="container">
    <text class="title">诊断</text>
    <text class="row">计划：{{planStatus}}</text>
    <text class="row">能力：{{capability}}</text>
    <text class="row">已注册提醒：{{registeredCount}}</text>
    <text class="row">快照版本：{{storeRevision}}</text>
    <text class="label">最近诊断</text>
    <text class="entry" for="{{entries}}">{{$item}}</text>
    <input type="button" class="btn" value="刷新" onclick="onRefresh"></input>
    <input type="button" class="btn" value="返回" onclick="onHome"></input>
</div>
