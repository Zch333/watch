{
  "app": {
    "bundleName": "com.move25.watch",
    "vendor": "Move25",
    "version": {
      "code": 1000000,
      "name": "1.0.0"
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page"
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.VIBRATE"
      }
    ],
    "js": [
      {
        "pages": [
          "pages/home/index",
          "pages/more/index",
          "pages/break-due/index",
          "pages/break-active/index",
          "pages/settings/index",
          "pages/diagnostics/index"
        ],
        "name": ".MainAbility"
      }
    ]
  }
}
